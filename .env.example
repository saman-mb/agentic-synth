# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# The loader (src/mapper/EnvLoader.cpp) checks the process environment first,
# then looks for a `.env` in the working directory and up to three parent
# directories — so running from `build/` still finds a `.env` at the repo root.

# Google Gemini API key, used for natural-language patch generation and for
# push-to-talk speech transcription. Get one at https://aistudio.google.com/apikey
#
# Without it TIMBRE still runs, falling back to the keyword heuristic parser —
# functional, but much blunter than the LLM path.
GEMINI_KEY=

# ── Netlify function rate limits (#309) ──────────────────────────────
# Durable tiered limits for /api/brief and /api/generate. Defaults:
#   demo 3/min + 200/day UTC; paid 30/min + 2000/day UTC.
# RATE_LIMIT_STORE=blobs (default, Netlify Blobs) | memory (local/tests)
# RATE_LIMIT_FAIL_MODE=closed (default) | open
# RATE_LIMIT_DEMO_MINUTE=3
# RATE_LIMIT_DEMO_DAY=200
# RATE_LIMIT_PAID_MINUTE=30
# RATE_LIMIT_PAID_DAY=2000
#
# Paid-tier stub for local only (prefer ENTITLEMENT_SIGNING_KEY in prod).
# RATE_LIMIT_PAID_STUB_TOKENS=comma,separated,tokens
# RATE_LIMIT_ALLOW_PAID_STUB=1   # Bearer paidstub.<subject> → paid tier
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_FAIL_MODE=closed

# ── Entitlement tokens (#312) ────────────────────────────────────────
# Server-only HS256 signing key for POST /api/entitlement → JWT
# (claims: sub, tier:"paid", exp — no secrets in the payload).
# ENTITLEMENT_SIGNING_KEY=
# ENTITLEMENT_TOKEN_TTL_SECONDS=3600
# Receipt validation: default unconfigured (503). Production: apple +
# APPLE_SHARED_SECRET + APPLE_BUNDLE_ID (+ optional APPLE_PRODUCT_ID).
# CI/local stub: ENTITLEMENT_RECEIPT_MODE=stub AND ENTITLEMENT_ALLOW_STUB_RECEIPTS=1
# ENTITLEMENT_RECEIPT_MODE=apple
# ENTITLEMENT_ALLOW_STUB_RECEIPTS=1
# APPLE_SHARED_SECRET=
# APPLE_BUNDLE_ID=
# APPLE_PRODUCT_ID=

# ── Global Gemini daily quota (#310) ─────────────────────────────────
# Global backstop after per-identity rate limits. UTC-day counters in
# Netlify Blobs (same store as rate limits by default). Counts each
# attempt that would call Gemini (billable-start), including failed ones.
# GEMINI_DAILY_CALL_CAP=10000
# GEMINI_DAILY_COST_CAP_USD=10
# GEMINI_EST_USD_PER_BRIEF=0.0004
# GEMINI_EST_USD_PER_GENERATE=0.0008
# GEMINI_SPEND_WARN_FRACTION=0.8
# QUOTA_STORE=blobs          # or memory; falls back to RATE_LIMIT_STORE
# QUOTA_FAIL_MODE=closed     # store errors → 503; falls back to RATE_LIMIT_FAIL_MODE

# ── Monitoring alerts (#313) — webhook and/or structured logs ────────
# ALERT_WEBHOOK_URL=https://hooks.example/incoming
# ALERT_ERROR_RATE_THRESHOLD=0.05
# ALERT_ERROR_RATE_WINDOW_MINUTES=10
# ALERT_ERROR_RATE_MIN_SAMPLES=20
# ALERT_ABUSE_429_PER_MINUTE=30
# Runbooks: docs/runbooks/gemini-spend.md , docs/runbooks/abuse-429.md
