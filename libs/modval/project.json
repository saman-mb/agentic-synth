{
  "name": "modval",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/modval/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:shared", "layer:feature"],
  "implicitDependencies": ["shared-types", "data"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint libs/modval"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test libs/modval/src/**/*.test.ts"
      }
    }
  }
}
